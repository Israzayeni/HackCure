{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Israzayeni/HackCure/contracts/correct_request.schema.json",
  "title": "CorrectRequest",
  "description": "Body of cases PATCH /samples/{id}/correct. corrected_abnormal must be <= corrected_count.",
  "type": "object",
  "required": [
    "corrected_count",
    "corrected_abnormal",
    "validator"
  ],
  "additionalProperties": false,
  "properties": {
    "corrected_count": {
      "type": "integer",
      "minimum": 0
    },
    "corrected_abnormal": {
      "type": "integer",
      "minimum": 0
    },
    "validator": {
      "type": "string",
      "minLength": 1
    },
    "comment": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
