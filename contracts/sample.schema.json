{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Israzayeni/HackCure/contracts/sample.schema.json",
  "title": "Sample",
  "description": "A row of the samples table. code is generated by the cases service, never a patient identifier; format S-YYYYMMDD-NNN (PROPOSED — confirm with team).",
  "type": "object",
  "required": [
    "id",
    "code",
    "created_at",
    "dilution_factor",
    "technician",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "code": {
      "type": "string",
      "pattern": "^S-[0-9]{8}-[0-9]{3}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "dilution_factor": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "technician": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "pending",
        "corrected",
        "validated"
      ]
    }
  }
}
