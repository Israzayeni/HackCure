{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Israzayeni/HackCure/contracts/rectangle.schema.json",
  "title": "Rectangle",
  "description": "One Malassez counting rectangle in preprocessed-image pixels. (x, y) is the top-left corner, i.e. where the rectangle's top and left grid lines cross; w and h run to the bottom and right grid lines.",
  "type": "object",
  "required": [
    "id",
    "x",
    "y",
    "w",
    "h"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 0
    },
    "x": {
      "type": "integer",
      "minimum": 0
    },
    "y": {
      "type": "integer",
      "minimum": 0
    },
    "w": {
      "type": "integer",
      "minimum": 1
    },
    "h": {
      "type": "integer",
      "minimum": 1
    }
  }
}
